<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome layer: required for Android 13+ themed icons (FR-17). The system
     tints this with the wallpaper palette, so every path must be solid white.
     Geometry matches ic_launcher_foreground and stays inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- clipboard outline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M37,40a5,5 0 0 1 5,-5h24a5,5 0 0 1 5,5v32a5,5 0 0 1 -5,5h-24a5,5 0 0 1 -5,-5z" />

    <!-- clip -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,29h12a3,3 0 0 1 3,3v3a2,2 0 0 1 -2,2h-14a2,2 0 0 1 -2,-2v-3a3,3 0 0 1 3,-3z" />

    <!-- checkmark -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M45,57 L52,64 L65,49" />
</vector>
